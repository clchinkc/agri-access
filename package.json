{
  "name": "agri-access",
  "version": "2.0.0",
  "description": "NASA Satellite-Powered Agricultural Credit Scoring for Indonesian Farmers",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "demo": "node demo.js",
    "dev": "node server.js",
    "test": "jest",
    "test:unit": "jest test/unit.test.js",
    "setup": "cp .env.example .env && echo 'Created .env file. Please update with your API keys.'",
    "lint": "echo 'Lint check passed - no linter configured'",
    "check": "npm run test:unit && npm run lint",
    "clean": "rm -rf node_modules package-lock.json && npm install"
  },
  "dependencies": {
    "@google/earthengine": "^1.4.0",
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.0",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "lib/**/*.js",
      "server.js"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  },
  "keywords": [
    "nasa",
    "satellite",
    "agriculture",
    "credit-scoring",
    "indonesia",
    "financial-inclusion"
  ],
  "author": "Agri-Access Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/agri-access/agri-access"
  },
  "homepage": "https://agri-access.github.io/agri-access"
}
